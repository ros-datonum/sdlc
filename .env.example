# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# FIBERY_SPACE_ID may be left empty: scripts/fibery_document_probe.py reports
# the candidate Space ids using only FIBERY_HOST and FIBERY_TOKEN.

FIBERY_HOST=your-workspace.fibery.io
FIBERY_TOKEN=
FIBERY_SPACE=
FIBERY_SPACE_ID=
